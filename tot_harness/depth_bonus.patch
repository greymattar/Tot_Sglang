+    def _candidate_trigger(self, child_completion: str) -> bool:
+        """
+        Modular trigger for 'turn off depth bonus'.
+        Implement only non_empty_extract_answer now; keep placeholder for future confidence signals.
+        """
+        mode = self.candidate_trigger_mode
+        if mode == "non_empty_extract_answer":
+            return bool(extract_answer(child_completion))
+        # Placeholder: "confidence_threshold" etc (not used yet)
+        return False
+
+
+    def _depth_bonus_active(self) -> bool:
+        if self.depth_bonus_mode == "always_off":
+            return False
+        if self.depth_bonus_mode == "always_on":
+            return True
+        # default / intended new behavior
+        if self.depth_bonus_mode == "until_first_candidate":
+            return (not self.candidate_found_yet)
+        # unknown mode -> safest fallback (baseline)
+        return False
+
+
+    def _depth_bonus_value(self, depth: int) -> float:
+        if not self._depth_bonus_active():
+            return 0.0
+        if self.alpha_depth == 0.0:
+            return 0.0
+        d = depth
+        if self.depth_bonus_cap is not None:
+            d = min(d, self.depth_bonus_cap)
+        return self.alpha_depth * float(d)
+
+
+    def frontier_item_for_node(self, node: Node):
+        """
+        Compute heap item for frontier push.
+        We want max effective_score, but heapq is min-heap -> store negative.
+        Applies depth bonus to CHILDREN at push time (as required).
+        """
+        effective_score = float(node.prm_score) + self._depth_bonus_value(node.depth)
+        priority_key = -effective_score
+
+        # Secondary / deterministic tie-break:
+        # When candidates not found yet, prefer deeper nodes on ties if enabled.
+        secondary_key = 0
+        if (not self.candidate_found_yet) and (self.tie_breaker == "prefer_deeper_until_candidate"):
+            secondary_key = -int(node.depth)
+
+        item = (priority_key, secondary_key, self.push_seq, node.node_id)
+        self.push_seq += 1
+        return item
+
